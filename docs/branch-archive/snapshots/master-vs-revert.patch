-
-def looks_like_text(sample: bytes) -> bool:
-    if not sample:
-        return True
-    if sample.startswith(codecs.BOM_UTF16_LE) or sample.startswith(
-        codecs.BOM_UTF16_BE
-    ):
-        try:
-            sample.decode("utf-16")
-            return True
-        except Exception:
-            return False
-    if b"\x00" in sample:
-        return False
-    for encoding in ("utf-8-sig", "cp1256", "latin-1"):
-        try:
-            sample.decode(encoding)
-            return True
-        except Exception:
-            continue
-    return False
-
-
-def extract_text_from_stream(
-    byte_iter: Iterator[bytes], max_chars: int
-) -> tuple[str, bool]:
-    """Decode a byte stream incrementally.  Returns (text, reached_eof).
-
-    UTF-16 is used only when an explicit UTF-16 BOM is present; arbitrary
-    even-length bytes are never guessed as UTF-16.  Otherwise an incremental
-    UTF-8 decoder is used and, when that produces many replacement
-    characters, the bytes are retried as Windows-1256 (common for older
-    Persian text).  When reading stops before EOF, an incomplete trailing
-    character is left undecoded instead of becoming a replacement char.
-    """
-    buffered = bytearray()
-    reached_eof = False
-    char_budget = max_chars * 4  # bytes are an upper bound for decoded chars
-    for chunk in byte_iter:
-        buffered.extend(chunk)
-        if len(buffered) >= char_budget:
-            break
-    else:
-        reached_eof = True
-    data = bytes(buffered)
-    if data.startswith(codecs.BOM_UTF16_LE) or data.startswith(
-        codecs.BOM_UTF16_BE
-    ):
-        decoder = codecs.getincrementaldecoder("utf-16")(errors="replace")
-        text = decoder.decode(data, final=reached_eof)
-    else:
-        decoder = codecs.getincrementaldecoder("utf-8-sig")(errors="replace")
-        text = decoder.decode(data, final=reached_eof)
-        replacement_count = text.count("\ufffd")
-        if replacement_count > 8 and replacement_count / max(len(text), 1) > 0.01:
-            fallback = data.decode("cp1256", errors="replace")
-            if fallback.count("\ufffd") < replacement_count:
-                text = fallback
-    if len(text) > max_chars:
-        text = text[:max_chars]
-        reached_eof = False
-    return text, reached_eof
-
-
-def read_plain_text(path: Path, max_chars: int) -> tuple[str, str]:
-    """Return (text, status) where status is full|partial."""
-
-    def gen() -> Iterator[bytes]:
-        with open(path, "rb") as fh:
-            while True:
-                chunk = fh.read(65536)
-                if not chunk:
-                    break
-                yield chunk
-
-    text, eof = extract_text_from_stream(gen(), max_chars)
-    if path.suffix.lower() in (".html", ".htm"):
-        text = _strip_html(text)
-    return text, "full" if eof else "partial"
-
-
-def extract_office_text(path: Path, max_chars: int) -> tuple[str, str]:
-    """Extract text from docx/xlsx/pptx/odt/epub using only zip+xml."""
-    suffix = path.suffix.lower()
-    texts: list[str] = []
-    total = 0
-    try:
-        with zipfile.ZipFile(path) as zf:
-            names = zf.namelist()
-            if suffix == ".docx":
-                wanted = [n for n in names if n == "word/document.xml"]
-            elif suffix == ".xlsx":
-                wanted = [
-                    n for n in names
-                    if n == "xl/sharedStrings.xml" or n.startswith("xl/worksheets/")
-                ]
-            elif suffix == ".pptx":
-                wanted = [n for n in names if n.startswith("ppt/slides/slide")]
-            elif suffix == ".odt":
-                wanted = [n for n in names if n == "content.xml"]
-            elif suffix == ".epub":
-                wanted = [
-                    n for n in names
-                    if n.lower().endswith((".xhtml", ".html", ".htm", ".xml", ".opf", ".ncx"))
-                ]
-            else:
-                wanted = []
-            truncated = False
-            member_limit = max(1_000_000, max_chars * 4)
-            wanted_names = set(wanted)
-            wanted_infos = [
-                info for info in zf.infolist() if info.filename in wanted_names
-            ]
-            for info in sorted(wanted_infos, key=lambda item: item.filename):
-                name = info.filename
-                if info.file_size > member_limit:
-                    truncated = True
-                    continue
-                try:
-                    with zf.open(info) as member:
-                        blob = member.read(member_limit + 1)
-                except Exception:
-                    continue
-                if len(blob) > member_limit:
-                    truncated = True
-                    continue
-                if suffix == ".epub" and not name.lower().endswith((".opf", ".ncx", ".xml")):
-                    piece = _strip_html(
-                        blob.decode("utf-8", errors="replace")
-                    )
-                else:
-                    piece = _xml_text(blob)
-                if piece:
-                    texts.append(piece)
-                    total += len(piece)
-                if total >= max_chars:
-                    truncated = True
-                    break
-    except (zipfile.BadZipFile, OSError):
-        return "", "unread"
-    text = " ".join(texts)[:max_chars]
-    if not text:
-        return "", "unread"
-    return text, "partial" if truncated else "full"
-
-
-def extract_pdf_text(path: Path, max_chars: int, max_pages: int) -> tuple[str, str, str]:
-    """Best-effort PDF text: optional pypdf/PyPDF2, else `pdftotext`.
-
-    Returns (text, status, unread_reason).  An image-only scan yields no
-    text and is honestly reported as unread."""
-    pdf_module = None
-    for module_name in ("pypdf", "PyPDF2"):
-        try:
-            pdf_module = __import__(module_name)
-            break
-        except Exception:
-            continue
-    if pdf_module is not None:
-        try:
-            reader = pdf_module.PdfReader(str(path))
-            pages = list(getattr(reader, "pages", []) or [])
-            selected = pages[: max_pages if max_pages > 0 else None]
-            pieces: list[str] = []
-            for page in selected:
-                try:
-                    pieces.append(page.extract_text() or "")
-                except Exception:
-                    continue
-            text = " ".join(pieces)[:max_chars]
-            if not text.strip():
-                return "", "unread", "PDF بدون لایه متن (اسکن تصویری)"
-            status = "full" if len(selected) >= len(pages) else "partial"
-            return text, status, ""
-        except Exception as exc:  # malformed/encrypted PDF
-            return "", "unread", f"خطای خواندن PDF: {type(exc).__name__}"
-
-    pdftotext = shutil.which("pdftotext")
-    if pdftotext:
-        cmd = [pdftotext, "-layout"]
-        partial = False
-        if max_pages > 0:
-            cmd += ["-f", "1", "-l", str(max_pages)]
-            partial = True
-        cmd += [str(path), "-"]
-        try:
-            proc = subprocess.run(
-                cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120
-            )
-        except Exception as exc:
-            return "", "unread", f"خطای pdftotext: {type(exc).__name__}"
-        text = proc.stdout.decode("utf-8", errors="replace")[:max_chars]
-        if not text.strip():
-            return "", "unread", "PDF بدون لایه متن (اسکن تصویری)"
-        return text, "partial" if partial else "full", ""
-
-    return "", "unread", "PDF — نه pypdf نصب است نه pdftotext در PATH هست"
-
