-def scan_local_tree(
-    root: Path, kw: KeywordSet, opts: ScanOptions, cache: HashCache,
-    *, include_folders: bool, offset: int, limit: int,
-    batch_size: int, progress: bool,
-) -> tuple[list[Row], list[ArchiveMember], dict[str, Any]]:
-    entries: list[tuple[Path, Optional[Row]]] = []
-
-    def special_for(candidate: Path) -> tuple[Path, Optional[Row]]:
-        rel = candidate.relative_to(root).as_posix()
-        try:
-            lstat_result = candidate.lstat()
-        except OSError as exc:
-            return candidate, _special_entry_row(
-                candidate, rel, kw,
-                f"lstat ناموفق بود: {type(exc).__name__}",
-                "unknown (lstat failed)",
-            )
-        if stat.S_ISLNK(lstat_result.st_mode):
-            return candidate, _special_entry_row(
-                candidate, rel, kw,
-                "پیوند نمادین است و برای ایمنی دنبال نشد",
-                "symlink", lstat_result,
-            )
-        return candidate, _special_entry_row(
-            candidate, rel, kw,
-            "فایل ویژه است و خوانده نشد",
-            _special_type_label(lstat_result.st_mode), lstat_result,
-        )
-
-    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
-        dirnames.sort()
-        filenames.sort()
-        current = Path(dirpath)
-        real_dirnames: list[str] = []
-        for dirname in list(dirnames):
-            candidate = current / dirname
-            try:
-                mode = candidate.lstat().st_mode
-            except OSError:
-                entries.append(special_for(candidate))
-                continue
-            if not stat.S_ISDIR(mode):
-                entries.append(special_for(candidate))
-                continue
-            real_dirnames.append(dirname)
-            if include_folders:
-                entries.append((candidate, None))
-        dirnames[:] = real_dirnames
-        for filename in filenames:
-            candidate = current / filename
-            try:
-                mode = candidate.lstat().st_mode
-            except OSError:
-                entries.append(special_for(candidate))
-                continue
-            if stat.S_ISREG(mode):
-                entries.append((candidate, None))
-            else:
-                entries.append(special_for(candidate))
-
-    def sort_key(item: tuple[Path, Optional[Row]]) -> str:
-        return item[0].relative_to(root).as_posix()
-
-    entries.sort(key=sort_key)
-    total_seen = len(entries)
-    selected = entries[offset:]
-    if limit > 0:
-        selected = selected[:limit]
-
-    rows: list[Row] = []
-    archive_rows: list[ArchiveMember] = []
-    for index, (entry, special_row) in enumerate(selected, start=1):
-        rel = entry.relative_to(root).as_posix()
-        if special_row is not None:
-            rows.append(special_row)
-        else:
-            rows.append(
-                analyze_local_file(entry, rel, kw, opts, cache, archive_rows)
-            )
-        if progress and batch_size > 0 and index % batch_size == 0:
-            print(f"[progress] processed {offset + index}/{total_seen}", file=sys.stderr)
-    meta = {
-        "mode": "local",
-        "source": str(root),
-        "total_seen": total_seen,
-        "processed_offset": offset,
-        "processed_count": len(rows),
-        "processed_end": offset + len(rows),
-        "partial": (offset + len(rows)) < total_seen,
-    }
-    return rows, archive_rows, meta
