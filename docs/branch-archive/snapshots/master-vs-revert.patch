-
-def _member_note(member_name: str) -> str:
-    lowered = member_name.lower()
-    if lowered.endswith((".zip", ".rar", ".7z", ".tar", ".tgz", ".gz", ".bz2", ".xz")):
-        return "آرشیو تو در تو — در این ابزار باز نشد"
-    return ""
