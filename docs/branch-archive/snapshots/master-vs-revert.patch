-    _extract_file_lists(raw, items)
-    deduped: dict[str, dict[str, Any]] = {}
-    unnamed: list[dict[str, Any]] = []
-    for item in items:
-        item_id = str(
-            _first(item, "id", "ID", "Path", default="") or ""
-        )
-        if item_id:
-            deduped[item_id] = item
-        else:
-            unnamed.append(item)
-    return list(deduped.values()) + unnamed
