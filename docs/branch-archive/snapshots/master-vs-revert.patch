-# --------------------------------------------------------------------------- #
-# Normalisation / keyword matching
-# --------------------------------------------------------------------------- #
-
-_NORMALISE_MAP = str.maketrans({
-    "\u064a": "\u06cc",  # Arabic yeh -> Farsi yeh
-    "\u0643": "\u06a9",  # Arabic kaf -> Farsi keheh
-    "\u0623": "\u0627",
-    "\u0625": "\u0627",
-    "\u0640": "",        # tatweel
-    "\u200c": " ",       # ZWNJ
