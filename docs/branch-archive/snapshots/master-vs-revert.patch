-def _open_output_text(path: Path, *, encoding: str, newline: Optional[str] = None):
-    """Open a report file without following a pre-existing symlink there."""
-    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
-    if hasattr(os, "O_NOFOLLOW"):
-        flags |= os.O_NOFOLLOW
-    if hasattr(os, "O_CLOEXEC"):
-        flags |= os.O_CLOEXEC
-    fd = os.open(path, flags, 0o600)
-    return os.fdopen(fd, "w", encoding=encoding, newline=newline)
-
-
-class HashCache:
-    def __init__(self, path: Path) -> None:
-        self.path = path
-        self.entries: dict[str, dict[str, Any]] = {}
-        if path.is_file() and not path.is_symlink():
-            try:
-                with open(path, "r", encoding="utf-8") as fh:
-                    raw = json.load(fh)
-                if isinstance(raw, dict):
-                    self.entries = raw
-            except Exception:
-                self.entries = {}
-
-    def get(self, key: str, size: int, mtime_ns: int) -> Optional[str]:
-        entry = self.entries.get(key)
-        if entry and entry.get("size") == size and entry.get("mtime_ns") == mtime_ns:
-            value = entry.get("sha256")
-            return value if isinstance(value, str) else None
-        return None
-
-    def put(self, key: str, size: int, mtime_ns: int, digest: str) -> None:
-        self.entries[key] = {"size": size, "mtime_ns": mtime_ns, "sha256": digest}
-
-    def save(self) -> None:
-        self.path.parent.mkdir(parents=True, exist_ok=True)
-        with _open_output_text(self.path, encoding="utf-8") as fh:
-            json.dump(self.entries, fh, ensure_ascii=False, sort_keys=True)
-
-
-def sha256_file(path: Path) -> str:
-    digest = hashlib.sha256()
-    with open(path, "rb") as fh:
-        while True:
-            chunk = fh.read(1024 * 1024)
-            if not chunk:
-                break
-            digest.update(chunk)
-    return digest.hexdigest()
